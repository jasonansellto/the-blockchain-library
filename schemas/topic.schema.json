{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theblockchainlibrary.com/schemas/topic.schema.json",
  "title": "Blockchain Library Topic",
  "type": "object",
  "required": [
    "id",
    "title",
    "slug",
    "summary",
    "level",
    "hub",
    "relatedTopics",
    "tags"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 2
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "summary": {
      "type": "string",
      "minLength": 30
    },
    "level": {
      "enum": [
        "foundation",
        "intermediate",
        "advanced"
      ]
    },
    "hub": {
      "type": "string",
      "pattern": "^/"
    },
    "primaryPage": {
      "type": "string"
    },
    "glossaryTerms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedTopics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "developerResources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "researchResources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "securityResources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}